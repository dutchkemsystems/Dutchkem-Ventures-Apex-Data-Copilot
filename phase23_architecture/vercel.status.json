{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "apex-public-status-page",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "domains": [
    "status.dutchkemventures.com"
  ],
  "headers": [
    {
      "source": "/api/status(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Security-Plane", "value": "public-status" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/status/:path*",
      "destination": "https://api.dutchkemventures.com/api/status/:path*"
    },
    {
      "source": "/api/status",
      "destination": "https://api.dutchkemventures.com/api/status"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
