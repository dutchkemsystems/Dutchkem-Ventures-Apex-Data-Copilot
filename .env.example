# =====================================================================
# Dutchkem Ventures Apex Data Copilot - Production Environment Template
# Copy to .env (local) or configure in Hosting / AI Studio Secrets.
# Never commit real API keys or webhook secrets into version control.
# =====================================================================

# Core Database & Media Asset Storage (Neon PostgreSQL + Upstash Redis)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require&channel_binding=require"
REDIS_URL="rediss://default:MY_UPSTASH_TOKEN@HOST.upstash.io:6379"

# AI & Synthetic Media Providers (Gemini + NVIDIA NIM)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"

# Default Payment & Payout Gateway (Kora Pay - Local NGN & Global USD/GBP/EUR)
KORA_PUBLIC_KEY="MY_KORA_PUBLIC_KEY"
KORA_SECRET_KEY="MY_KORA_SECRET_KEY"
KORA_WEBHOOK_SECRET="MY_KORA_WEBHOOK_SECRET_OR_URL"
KORA_ENCRYPTION_KEY="MY_KORA_ENCRYPTION_KEY"
NEXT_PUBLIC_KORA_PUBLIC_KEY="MY_KORA_PUBLIC_KEY"

# Runtime URLs & Military-Grade Security Secrets
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
FASTAPI_BACKEND_URL="http://127.0.0.1:8000"
SESSION_SIGNING_SECRET="MY_SESSION_SIGNING_SECRET"
CRON_SECRET="MY_VERCEL_CRON_BEARER_SECRET"

# Phase 19: Three-Plane Auth, Envelope KMS, TOTP 2FA, Transport & Session Blocklist
# CRITICAL: ADMIN_JWT_SECRET and USER_JWT_SECRET MUST be cryptographically separate keys
ADMIN_JWT_SECRET="REPLACE_WITH_64_CHAR_HEX_ADMIN_JWT_SECRET"
USER_JWT_SECRET="REPLACE_WITH_64_CHAR_HEX_USER_JWT_SECRET"
KMS_KEK_USER_ID="kms-kek-user-v1"
KMS_KEK_ADMIN_ID="kms-kek-admin-v1"
KMS_KEK_USER_SECRET="REPLACE_WITH_64_CHAR_HEX_KEK_USER_SECRET"
KMS_KEK_ADMIN_SECRET="REPLACE_WITH_64_CHAR_HEX_KEK_ADMIN_SECRET"
TOTP_ISSUER=DutchkemApex
HSTS_MAX_AGE=63072000
COOKIE_DOMAIN=apexdata.dutchkemventures.com

# Phase 19F / 19G: Redis Blocklist & Super Admin Incident Alerting
UPSTASH_REDIS_REST_URL="https://MY_UPSTASH_ENDPOINT.upstash.io"
UPSTASH_REDIS_REST_TOKEN="MY_UPSTASH_REDIS_REST_TOKEN"
SUPER_ADMIN_ALERT_EMAIL="superadmin@dutchkemventures.com"
SLACK_SECURITY_WEBHOOK_URL="https://hooks.slack.com/services/REPLACE/ME/NOW"
RESEND_API_KEY="MY_RESEND_API_KEY"

# Phase 20C: Upstash Rate Limits & Daily AI Cost Circuit Breaker
AI_DAILY_COST_LIMIT_USD="100.00"
RATE_LIMIT_B2B_HOURLY="1000"
RATE_LIMIT_QA_PRO_HOURLY="50"

# Phase 21A: HashiCorp Vault Prompt Store & PromptGuard Shield
VAULT_ADDR="https://vault.internal.dutchkemventures.com:8200"
VAULT_TOKEN="REPLACE_WITH_VAULT_SERVICE_TOKEN"
VAULT_KV_MOUNT="apex-prompts"
VAULT_FAIL_CLOSED="true"
PROMPT_GUARD_STRICT_FAIL_CLOSED="true"
AWS_SECRETS_MANAGER_ENABLED="false"
AWS_SECRETS_MANAGER_PREFIX="apex/prompts"

# Phase 21B: Zero-Trust Anomaly Detection, IP Reputation & Impossible Travel
IPQS_API_KEY="MY_IPQUALITYSCORE_API_KEY"
ABUSEIPDB_API_KEY="MY_ABUSEIPDB_API_KEY"
TURNSTILE_SITE_KEY="MY_CLOUDFLARE_TURNSTILE_SITE_KEY"
TURNSTILE_SECRET_KEY="MY_CLOUDFLARE_TURNSTILE_SECRET_KEY"
ANOMALY_SCORE_BLOCK_THRESHOLD="80"
IMPOSSIBLE_TRAVEL_KM="500"
IMPOSSIBLE_TRAVEL_MINUTES="60"
ANOMALY_FAIL_CLOSED="true"

# Phase 21C: WebAuthn Passkeys & Admin Hardware YubiKey Verification
WEBAUTHN_RP_NAME="Dutchkem Ventures Apex Data Copilot"
WEBAUTHN_RP_ID="apexdata.dutchkemventures.com"
WEBAUTHN_ORIGIN="https://apexdata.dutchkemventures.com"
ADMIN_REQUIRE_YUBIKEY="true"

# Phase 21D: Immutable Audit Merkle Chain & AWS S3 Object Lock (WORM)
AWS_S3_AUDIT_BUCKET="apex-immutable-audit-worm"
AWS_S3_AUDIT_REGION="eu-west-1"
AWS_ACCESS_KEY_ID="MY_AWS_WORM_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="MY_AWS_WORM_SECRET_ACCESS_KEY"
AUDIT_WORM_OBJECT_LOCK_MODE="COMPLIANCE"
AUDIT_WORM_RETENTION_DAYS="2555"
AUDIT_WORM_STRICT_S3="false"

# Phase 21H: Enterprise Smart Contract Escrow (Polygon PoS USDC > $10,000)
POLYGON_NETWORK="mainnet"
POLYGON_RPC_URL="https://polygon-rpc.com"
POLYGON_ESCROW_CONTRACT_ADDRESS=""
POLYGON_QA_ORACLE_ADDRESS=""
POLYGON_QA_ORACLE_SECRET=""
POLYGON_TREASURY_ADDRESS=""

# Phase 23A: Autonomous DevOps, Zero-Downtime Rolling Deploys & 7-Day Redis Sessions
USER_SESSION_TTL_SECONDS="604800"
USER_FRONTEND_URL="https://apexdata.dutchkemventures.com"
ADMIN_FRONTEND_URL="https://admin.dutchkemventures.com"
DEPLOYMENT_ID="local-dev"
GIT_COMMIT_SHA="dev"
HEALTH_WARMUP_SECONDS="30"

# Phase 23B: Automated Dependency Updates, Snyk Supply-Chain Scanning & Weekly Security Audits
SNYK_TOKEN="MY_SNYK_ORG_OR_SERVICE_TOKEN"
SNYK_ORG="dutchkem-ventures"
DEPENDABOT_AUTO_MERGE_PATCH="true"

# Phase 23C: Feature Flags & 24h Progressive Canary Releases (PostHog / Unleash)
POSTHOG_HOST="https://us.i.posthog.com"
POSTHOG_PROJECT_API_KEY="MY_POSTHOG_PROJECT_API_KEY"
POSTHOG_PERSONAL_API_KEY="MY_POSTHOG_PERSONAL_API_KEY"
POSTHOG_PROJECT_ID="MY_POSTHOG_PROJECT_ID"
UNLEASH_URL=""
UNLEASH_API_TOKEN=""

# Phase 23D: Zero-Downtime Expand-Contract Migrations & Neon Shadow DB Testing
NEON_API_KEY="MY_NEON_API_KEY"
NEON_PROJECT_ID="MY_NEON_PROJECT_ID"
NEON_SHADOW_DATABASE_URL=""

# Phase 23E: Self-Healing, Sentry 5xx Incident Reporting, PagerDuty & Auto-Rollback
SENTRY_DSN=""
PAGERDUTY_ROUTING_KEY=""
PREVIOUS_DEPLOYMENT_ID="dep-v22-stable"


